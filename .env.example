# Nivas360 Server Environment Configuration Example
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nivas360
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NODE_ENV=development

# Gmail SMTP Configuration (Nodemailer)
# Sender Account: grih360@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=grih360@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM=Nivas360 <grih360@gmail.com>
EMAIL_OTP_EXPIRY_MINUTES=5
EMAIL_OTP_LENGTH=6
