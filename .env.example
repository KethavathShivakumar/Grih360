# Nivas360 Server Environment Configuration Example
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nivas360
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NODE_ENV=development

# Google OAuth2 & Gmail API Configuration
# Sender Account: grih360@gmail.com
GMAIL_SENDER_EMAIL=grih360@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional override; defaults to ${BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
# Captured automatically via OAuth callback, or pasted into Vercel Project Settings:
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here
# Secret key to authorize initial setup endpoint (/api/v1/auth/google/authorize?setup_key=...)
OAUTH_SETUP_KEY=your_secure_random_setup_key_here
